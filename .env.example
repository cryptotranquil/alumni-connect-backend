# ── Server ───────────────────────────────────────
PORT=5000
JWT_SECRET=use-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# Public URL of the React app (password-reset + admin-invite emails)
FRONTEND_URL=http://localhost:5173

# API's own base URL (used by the cron job that calls /events/reminders)
# BASE_URL=http://localhost:5000

# Optional: restrict CORS (default allows all in dev)
# CORS_ORIGIN=http://localhost:5173

# ── Firestore (firebase-admin) ───────────────────
# base64-encoded service-account JSON. Put the REAL value in .env (and Vercel),
# never in this file.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")) | Set-Clipboard
FIREBASE_SERVICE_ACCOUNT_JSON=
CRON_SECRET=choose-a-long-random-secret

# ── Brevo — transactional email ─────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Alumni Connect

# ── Cloudinary — CV + profile-photo uploads ─────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=alumni-connect

